---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Brands from "../components/Brands.astro";
import Footer from "../components/Footer.astro";

// Kategorie są ładowane automatycznie ze src/content/categories/*.json
// Sortowane po polu `order`, potem alfabetycznie po nazwie.
const categories = (await getCollection("categories")).sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return a.data.name.localeCompare(b.data.name, "pl");
});
---

<Layout title="Centrum pomocy — wizytowki.co">
    <Nav variant="dark" />

    <!-- HERO -->
    <section class="hero">
        <div class="hero-inner">
            <h1 class="hero-title">Centrum pomocy</h1>
            <p class="hero-sub">
                Wszystko co musisz wiedzieć o naszych wizytówkach i innych
                produktach.<br />
                Przejrzyj dostępne tematy lub skorzystaj z poniższej wyszukiwarki.
            </p>
            <form class="search-wrap" role="search" action="/" method="get">
                <svg
                    class="search-icon"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <input
                    type="search"
                    name="q"
                    placeholder="Czego szukasz?"
                    aria-label="Szukaj w Centrum pomocy"
                    class="search-input"
                />
            </form>
        </div>
    </section>

    <!-- TOPICS -->
    <section class="topics-section">
        <div class="topics-container">
            <h2 class="section-heading">
                <span class="section-heading-strong"
                    >Często poruszane tematy.</span
                ><br />
                <span class="section-heading-soft">Zacznij tutaj.</span>
            </h2>
            <div class="topic-grid">
                {
                    categories.map((category) => (
                        <a
                            href={`/${category.id}/`}
                            class="topic-card"
                            aria-label={`Kategoria: ${category.data.name}`}
                        >
                            <div class="topic-card-icon" aria-hidden="true">
                                <svg
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                </svg>
                            </div>
                            <div class="topic-card-body">
                                <h3 class="topic-card-title">
                                    {category.data.name}
                                </h3>
                                <p class="topic-card-desc">
                                    {category.data.description}
                                </p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <CtaBanner />
    <Brands />
    <Footer />
</Layout>
