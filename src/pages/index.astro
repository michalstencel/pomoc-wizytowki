---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Brands from "../components/Brands.astro";
import Footer from "../components/Footer.astro";

// Kategorie są ładowane automatycznie ze src/content/categories/*.json
// Sortowane po polu `order`, potem alfabetycznie po nazwie.
const categories = (await getCollection("categories")).sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return a.data.name.localeCompare(b.data.name, "pl");
});
---

<Layout title="Centrum pomocy — wizytowki.co">
    <Nav variant="dark" />

    <!-- HERO -->
    <section class="hero">
        <div class="hero-inner">
            <h1 class="hero-title">Centrum pomocy</h1>
            <p class="hero-sub">
                Wszystko co musisz wiedzieć o naszych wizytówkach i innych
                produktach.<br />
                Przejrzyj dostępne tematy lub skorzystaj z poniższej wyszukiwarki.
            </p>
            <div class="search-wrap">
                <div id="search"></div>
            </div>
        </div>
    </section>

    <!-- TOPICS -->
    <section class="topics-section">
        <div class="topics-container">
            <h2 class="section-heading">
                <span class="section-heading-strong"
                    >Często poruszane tematy.</span
                ><br />
                <span class="section-heading-soft">Zacznij tutaj.</span>
            </h2>
            <div class="topic-grid">
                {
                    categories.map((category) => (
                        <a
                            href={`/${category.id}/`}
                            class="topic-card"
                            aria-label={`Kategoria: ${category.data.name}`}
                        >
                            <div class="topic-card-icon" aria-hidden="true">
                                <svg
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                </svg>
                            </div>
                            <div class="topic-card-body">
                                <h3 class="topic-card-title">
                                    {category.data.name}
                                </h3>
                                <p class="topic-card-desc">
                                    {category.data.description}
                                </p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <CtaBanner />
    <Brands />
    <Footer />
</Layout>

<!--
    Pagefind UI: indeks i UI generowane przez astro-pagefind w trakcie `astro build`.
    Pliki są dostępne pod /pagefind/* w czasie runtime.
    Używamy is:inline, żeby Vite/Rollup NIE próbowało rozwiązać tych ścieżek w czasie buildu
    (plik /pagefind/pagefind-ui.js powstaje dopiero PO astro build).
-->
<script is:inline src="/pagefind/pagefind-ui.js" defer></script>
<script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
        if (typeof PagefindUI === "undefined") return;
        new PagefindUI({
            element: "#search",
            showImages: false,
            showSubResults: true,
            resetStyles: false,
            translations: {
                placeholder: "Czego szukasz?",
                clear_search: "Wyczyść",
                load_more: "Pokaż więcej wyników",
                search_label: "Szukaj w Centrum pomocy",
                filters_label: "Filtry",
                zero_results: "Brak wyników dla [SEARCH_TERM]",
                many_results: "[COUNT] wyników dla [SEARCH_TERM]",
                one_result: "[COUNT] wynik dla [SEARCH_TERM]",
                alt_search:
                    "Brak wyników dla [SEARCH_TERM]. Pokazuję wyniki dla [DIFFERENT_TERM]",
                search_suggestion:
                    "Brak wyników dla [SEARCH_TERM]. Spróbuj jednego z poniższych haseł:",
                searching: "Szukam [SEARCH_TERM]…",
            },
        });
    });
</script>
