---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import Brands from "../../components/Brands.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
    const categories = await getCollection("categories");
    return categories.map((category) => ({
        params: { category: category.id },
        props: { category },
    }));
}

const { category } = Astro.props;

// Wszystkie artykuły tej kategorii (folder = kategoria).
// W glob loader id ma format "kategoria/slug" (bez rozszerzenia .md).
const articles = (await getCollection("articles"))
    .filter((a) => a.id.split("/")[0] === category.id)
    .sort((a, b) => {
        if (a.data.order !== b.data.order) return a.data.order - b.data.order;
        return a.data.title.localeCompare(b.data.title, "pl");
    });

// Grupowanie po podkategorii (z frontmattera artykułu).
const grouped = articles.reduce(
    (acc, article) => {
        const sub = article.data.subcategory;
        if (!acc[sub]) acc[sub] = [];
        acc[sub].push(article);
        return acc;
    },
    {} as Record<string, typeof articles>,
);

const subcategoryEntries = Object.entries(grouped);
---

<Layout title={`${category.data.name} — Centrum pomocy`}>
    <Nav variant="light" />
    <main class="category-main">
        <div class="category-container">
            <div class="category-header">
                <a href="/" class="category-back">← wróć do Centrum pomocy</a>
                <h1 class="category-title">{category.data.name}</h1>
                <p class="category-description">{category.data.description}</p>
            </div>

            {
                subcategoryEntries.length === 0 ? (
                    <p class="category-empty">
                        W tej kategorii nie ma jeszcze artykułów. Zajrzyj
                        wkrótce.
                    </p>
                ) : (
                    <div class="category-grid">
                        {subcategoryEntries.map(([subcategory, items]) => (
                            <div class="category-group">
                                <h2 class="category-group-title">
                                    {subcategory}
                                </h2>
                                <ul class="category-links">
                                    {items.map((article) => {
                                        const slug = article.id
                                            .split("/")
                                            .slice(1)
                                            .join("/");
                                        return (
                                            <li>
                                                <a
                                                    href={`/${category.id}/${slug}/`}
                                                    class="category-link"
                                                >
                                                    {article.data.title}
                                                </a>
                                            </li>
                                        );
                                    })}
                                </ul>
                            </div>
                        ))}
                    </div>
                )
            }
        </div>
    </main>
    <CtaBanner />
    <Brands />
    <Footer />
</Layout>
