---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import Brands from "../../components/Brands.astro";
import Footer from "../../components/Footer.astro";
import {
    client,
    QUERY_ALL_CATEGORIES,
    QUERY_CATEGORY_BY_SLUG,
    QUERY_ARTICLES_BY_CATEGORY,
    type Category,
    type ArticleListItem,
} from "../../lib/sanity";

export async function getStaticPaths() {
    const categories = await client.fetch<Category[]>(QUERY_ALL_CATEGORIES);
    return categories.map((category) => ({
        params: { category: category.slug.current },
    }));
}

const { category: categorySlug } = Astro.params;

const category = await client.fetch<Category | null>(QUERY_CATEGORY_BY_SLUG, {
    slug: categorySlug,
});

if (!category) {
    return Astro.redirect("/404");
}

const articles = (
    await client.fetch<ArticleListItem[]>(QUERY_ARTICLES_BY_CATEGORY, {
        slug: categorySlug,
    })
).sort((a, b) => a.title.localeCompare(b.title, "pl"));

interface GroupedArticle {
    article: ArticleListItem;
    subcategoryName: string;
}

const grouped = articles.reduce(
    (acc, article) => {
        const placement = article.placements.find(
            (p) => p.category.slug.current === categorySlug,
        );
        if (!placement) return acc;
        const sub = placement.subcategory;
        if (!acc[sub]) acc[sub] = [];
        acc[sub].push({ article, subcategoryName: sub });
        return acc;
    },
    {} as Record<string, GroupedArticle[]>,
);

const subcategoryEntries = Object.entries(grouped).sort(([a], [b]) =>
    a.localeCompare(b, "pl"),
);
---

<Layout title={`${category.name} — Centrum pomocy`}>
    <Nav variant="light" />
    <main class="category-main">
        <div class="category-container">
            <div class="category-header">
                <h1 class="category-title">{category.name}</h1>
                <a href="/" class="category-back">← wróć do Centrum Pomocy</a>
            </div>

            {
                subcategoryEntries.length === 0 ? (
                    <p class="category-empty">
                        W tej kategorii nie ma jeszcze artykułów. Zajrzyj
                        wkrótce.
                    </p>
                ) : (
                    <div class="category-grid">
                        {subcategoryEntries.map(([subcategory, items]) => (
                            <div class="category-group">
                                <h2 class="category-group-title">
                                    {subcategory}
                                </h2>
                                <ul class="category-links">
                                    {items.map(({ article }) => (
                                        <li>
                                            <a
                                                href={`/${categorySlug}/${article.slug.current}/`}
                                                class="category-link"
                                            >
                                                {article.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                )
            }
        </div>
    </main>
    <CtaBanner />
    <Brands />
    <Footer />
</Layout>
