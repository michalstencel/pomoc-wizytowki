---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import {
    client,
    QUERY_ALL_ARTICLE_PATHS,
    QUERY_ARTICLE_BY_SLUG,
    QUERY_RELATED_ARTICLES,
    type Article,
    type ArticleListItem,
} from "../../lib/sanity";

export async function getStaticPaths() {
    const paths = await client.fetch<
        { slug: string; categorySlugs: string[] }[]
    >(QUERY_ALL_ARTICLE_PATHS);

    return paths.flatMap((p) =>
        (p.categorySlugs ?? [])
            .filter((c): c is string => Boolean(c))
            .map((categorySlug) => ({
                params: { category: categorySlug, slug: p.slug },
            })),
    );
}

const { category: categorySlug, slug } = Astro.params;

const article = await client.fetch<Article | null>(QUERY_ARTICLE_BY_SLUG, {
    slug,
    category: categorySlug,
});

if (!article) {
    return Astro.redirect("/404");
}

const currentPlacement = article.placements.find(
    (p) => p.category.slug.current === categorySlug,
);

if (!currentPlacement) {
    return Astro.redirect("/404");
}

const related = currentPlacement.subcategoryRef
    ? (
          await client.fetch<ArticleListItem[]>(QUERY_RELATED_ARTICLES, {
              categorySlug,
              subcategoryRef: currentPlacement.subcategoryRef,
              currentSlug: slug,
          })
      ).sort((a, b) => a.title.localeCompare(b.title, "pl"))
    : [];
---

<ArticleLayout
    article={article}
    related={related}
    currentPlacement={currentPlacement}
/>
