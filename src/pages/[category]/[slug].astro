---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import {
    client,
    QUERY_ALL_ARTICLE_PATHS,
    QUERY_ARTICLE_BY_SLUG,
    QUERY_RELATED_ARTICLES,
    type Article,
    type ArticleListItem,
} from "../../lib/sanity";

export async function getStaticPaths() {
    const paths = await client.fetch<{ slug: string; categorySlug: string }[]>(
        QUERY_ALL_ARTICLE_PATHS,
    );
    return paths
        .filter((p) => p.slug && p.categorySlug)
        .map((p) => ({
            params: { category: p.categorySlug, slug: p.slug },
        }));
}

const { category: categorySlug, slug } = Astro.params;

const article = await client.fetch<Article | null>(QUERY_ARTICLE_BY_SLUG, {
    slug,
    category: categorySlug,
});

if (!article) {
    return Astro.redirect("/404");
}

const related = await client.fetch<ArticleListItem[]>(QUERY_RELATED_ARTICLES, {
    categorySlug,
    subcategory: article.subcategory,
    currentSlug: slug,
});
---

<ArticleLayout article={article} related={related} />
