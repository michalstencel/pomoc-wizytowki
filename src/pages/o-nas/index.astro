---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import Brands from "../../components/Brands.astro";
import Footer from "../../components/Footer.astro";

const artykuly = [
    {
        podkategoria: "Informacje prawne",
        linki: [
            { tytul: "Formularze", slug: "formularze" },
            { tytul: "Polityka prywatności", slug: "polityka-prywatnosci" },
            { tytul: "Regulamin", slug: "regulamin" },
            { tytul: "Zasady reklamacji", slug: "zasady-reklamacji" },
        ],
    },
    {
        podkategoria: "O firmie",
        linki: [
            { tytul: "Kim jesteśmy", slug: "kim-jestesmy" },
            { tytul: "Misja i wartości", slug: "misja-i-wartosci" },
        ],
    },
    {
        podkategoria: "Współpraca",
        linki: [{ tytul: "Program partnerski", slug: "program-partnerski" }],
    },
];
---

<Layout title="O nas">
    <Nav variant="light" />

    <main class="category-main">
        <div class="category-container">
            <div class="category-header">
                <h1 class="category-title">O nas</h1>
                <a href="/" class="category-back">← wróć do Centrum Pomocy</a>
            </div>
            <div class="category-grid">
                {
                    artykuly.map((grupa) => (
                        <div class="category-group">
                            <h2 class="category-group-title">
                                {grupa.podkategoria}
                            </h2>
                            <ul class="category-links">
                                {grupa.linki.map((link) => (
                                    <li>
                                        <a
                                            href={`/o-nas/${link.slug}/`}
                                            class="category-link"
                                        >
                                            {link.tytul}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </main>

    <CtaBanner />
    <Brands />
    <Footer />
</Layout>
