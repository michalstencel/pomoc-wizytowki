---
import { toHTML, type PortableTextHtmlComponents } from "@portabletext/to-html";
import type { PortableTextBlock } from "@portabletext/types";
import { urlForImage } from "../lib/sanity";

interface Props {
    value: PortableTextBlock[] | undefined | null;
}

const { value } = Astro.props;

function escapeHtml(input: string): string {
    return input
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}

const components: Partial<PortableTextHtmlComponents> = {
    types: {
        image: ({ value }) => {
            if (!value?.asset) return "";
            const url = urlForImage(value)
                .width(1200)
                .fit("max")
                .auto("format")
                .url();
            const alt = escapeHtml(value.alt ?? "");
            const caption = value.caption ? escapeHtml(value.caption) : "";
            const figcaption = caption
                ? `<figcaption class="article-figcaption">${caption}</figcaption>`
                : "";
            return `<figure class="article-figure">
                <img src="${url}" alt="${alt}" loading="lazy" decoding="async" />
                ${figcaption}
            </figure>`;
        },
    },
    marks: {
        link: ({ children, value }) => {
            const href = value?.href ?? "#";
            const safeHref = escapeHtml(href);
            const isExternal = /^https?:\/\//i.test(href);
            const externalAttrs = isExternal
                ? ' rel="noopener noreferrer" target="_blank"'
                : "";
            return `<a href="${safeHref}"${externalAttrs}>${children}</a>`;
        },
        code: ({ children }) => `<code>${children}</code>`,
        "strike-through": ({ children }) => `<s>${children}</s>`,
    },
};

const html = value ? toHTML(value, { components }) : "";
---

<Fragment set:html={html} />
