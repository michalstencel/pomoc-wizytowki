---
import { toHTML, type PortableTextHtmlComponents } from "@portabletext/to-html";
import type { PortableTextBlock } from "@portabletext/types";
import { urlForImage } from "../lib/sanity";

interface Props {
    value: PortableTextBlock[] | undefined | null;
}

const { value } = Astro.props;

function escapeHtml(input: string): string {
    return input
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}

function formatFileSize(bytes?: number): string {
    if (!bytes) return "";
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

const components: Partial<PortableTextHtmlComponents> = {
    types: {
        image: ({ value }) => {
            if (!value?.asset) return "";
            const url = urlForImage(value)
                .width(1200)
                .fit("max")
                .auto("format")
                .url();
            const alt = escapeHtml(value.alt ?? "");
            const caption = value.caption ? escapeHtml(value.caption) : "";
            const figcaption = caption
                ? `<figcaption class="article-figcaption">${caption}</figcaption>`
                : "";
            return `<figure class="article-figure">
                <img src="${url}" alt="${alt}" loading="lazy" decoding="async" />
                ${figcaption}
            </figure>`;
        },
        htmlBlock: ({ value }) => {
            const html = typeof value?.html === "string" ? value.html : "";
            if (!html) return "";
            return `<div class="article-html-block">${html}</div>`;
        },
        table: ({ value }) => {
            const rows = Array.isArray(value?.rows) ? value.rows : [];
            if (rows.length === 0) return "";

            const renderCellText = (raw: string): string => {
                const linkPattern = /\[([^\]]+)\]\(([^)]+)\)/g;
                let result = "";
                let lastIdx = 0;
                let match: RegExpExecArray | null;
                while ((match = linkPattern.exec(raw)) !== null) {
                    result += escapeHtml(raw.slice(lastIdx, match.index));
                    const text = escapeHtml(match[1]);
                    const url = escapeHtml(match[2]);
                    const isExternal = /^https?:\/\//i.test(match[2]);
                    const externalAttrs = isExternal
                        ? ' target="_blank" rel="noopener noreferrer"'
                        : "";
                    result += `<a href="${url}"${externalAttrs}>${text}</a>`;
                    lastIdx = match.index + match[0].length;
                }
                result += escapeHtml(raw.slice(lastIdx));
                return result;
            };

            const renderRow = (
                row: { cells?: string[] } | undefined,
                tag: "th" | "td",
            ) => {
                const cells = Array.isArray(row?.cells) ? row.cells : [];
                return `<tr>${cells
                    .map((c) => `<${tag}>${renderCellText(c ?? "")}</${tag}>`)
                    .join("")}</tr>`;
            };

            let html = '<div class="article-html-block"><table>';
            html += `<thead>${renderRow(rows[0], "th")}</thead>`;
            if (rows.length > 1) {
                html += `<tbody>${rows
                    .slice(1)
                    .map((r) => renderRow(r, "td"))
                    .join("")}</tbody>`;
            }
            html += "</table></div>";
            return html;
        },
    },
    marks: {
        link: ({ children, value }) => {
            const href = value?.href ?? "#";
            const safeHref = escapeHtml(href);
            const isExternal = /^https?:\/\//i.test(href);
            const externalAttrs = isExternal
                ? ' rel="noopener noreferrer" target="_blank"'
                : "";
            return `<a href="${safeHref}"${externalAttrs}>${children}</a>`;
        },
        fileLink: ({ children, value }) => {
            const fileUrl = value?.fileUrl as string | undefined;
            if (!fileUrl) return `${children}`;
            const safeUrl = escapeHtml(fileUrl);
            const fileName = value?.fileName as string | undefined;
            const fileSize = formatFileSize(value?.fileSize as number | undefined);
            const ext = fileName?.split(".").pop()?.toUpperCase() ?? "";
            const meta = [ext, fileSize].filter(Boolean).join(" · ");
            const metaSpan = meta
                ? `<span class="article-file-meta">${escapeHtml(meta)}</span>`
                : "";
            return `<a href="${safeUrl}" class="article-file-link" target="_blank" rel="noopener noreferrer">${children}${metaSpan}</a>`;
        },
        code: ({ children }) => `<code>${children}</code>`,
        "strike-through": ({ children }) => `<s>${children}</s>`,
    },
};

const html = value ? toHTML(value, { components }) : "";
---

<Fragment set:html={html} />
