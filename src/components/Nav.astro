---
interface Props {
    variant?: "dark" | "light";
}

const { variant = "dark" } = Astro.props;
const logoSrc =
    variant === "dark" ? "/logo-wizytowki.svg" : "/logo-wizytowki-black.svg";
---

<nav class={`nav nav-${variant}`} aria-label="Główna nawigacja">
    <div class="nav-inner">
        <a href="https://wizytowki.co" class="nav-logo" aria-label="wizytowki.co — strona główna">
            <img src={logoSrc} alt="wizytowki.co" class="nav-logo-img" />
        </a>
        <div class="nav-links">
            <a href="https://wizytowki.co/wizytowki" class="nav-link">Wizytówki</a>
            <a href="https://wizytowki.co/projekt" class="nav-link">Projekt</a>
            <a href="https://wizytowki.co/inspiracje" class="nav-link">Inspiracje</a>
            <a href="https://wizytowki.co/kontakt" class="nav-link">Kontakt</a>
        </div>
        <a href="/" class="nav-link nav-link-help">Pomoc</a>
    </div>
</nav>
