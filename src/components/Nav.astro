---
const { variant = "dark" } = Astro.props;
const isDark = variant === "dark";
---

<nav class={isDark ? "nav nav-dark" : "nav nav-light"}>
    <div class="nav-inner">
        <a href="https://wizytowki.co">
            {
                isDark ? (
                    <img
                        src="/logo-wizytowki.svg"
                        alt="wizytowki.co"
                        class="h-8"
                    />
                ) : (
                    <img
                        src="/logo-wizytowki-black.svg"
                        alt="wizytowki.co"
                        class="h-8"
                    />
                )
            }
        </a>
        <div class="flex">
            <a href="https://wizytowki.co/wizytowki" class="nav-link"
                >Wizytówki</a
            >
            <a href="https://wizytowki.co/projekt" class="nav-link">Projekt</a>
            <a href="https://wizytowki.co/inspiracje" class="nav-link"
                >Inspiracje</a
            >
            <a href="https://wizytowki.co/kontakt" class="nav-link">Kontakt</a>
        </div>
        <a href="/" class="nav-link">Pomoc</a>
    </div>
</nav>
