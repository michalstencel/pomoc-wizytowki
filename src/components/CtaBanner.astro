---
---

<section class="cta-section">
    <div class="cta-section-inner">
        <div class="cta-banner">
            <div class="cta-banner-content">
                <div class="cta-banner-avatars">
                    <img
                        src="/2x@160x160michal.png"
                        alt="Michał"
                        class="cta-avatar cta-avatar-left"
                        loading="lazy"
                        decoding="async"
                        width="48"
                        height="48"
                    />
                    <img
                        src="/2x@160x160-magda.png"
                        alt="Magda"
                        class="cta-avatar cta-avatar-center"
                        loading="lazy"
                        decoding="async"
                        width="56"
                        height="56"
                    />
                    <img
                        src="/2x@160x160zuzia.png"
                        alt="Zuzia"
                        class="cta-avatar cta-avatar-right"
                        loading="lazy"
                        decoding="async"
                        width="48"
                        height="48"
                    />
                </div>
                <p class="cta-banner-title">Masz więcej pytań?</p>
                <p class="cta-banner-sub">
                    Poszukaj tematu w wyszukiwarce lub napisz do specjalistów z
                    naszego zespołu.
                </p>
            </div>
            <div class="cta-banner-btns">
                <a href="/" class="cta-banner-btn-secondary">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 22 22"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path
                            d="M11 15V11M11 7H11.01M21 11C21 16.5228 16.5228 21 11 21C5.47715 21 1 16.5228 1 11C1 5.47715 5.47715 1 11 1C16.5228 1 21 5.47715 21 11Z"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                    Centrum pomocy
                </a>
                <a
                    href="https://wizytowki.co/kontakt"
                    class="cta-banner-btn-primary">Skontaktuj się z nami</a
                >
            </div>
        </div>
    </div>
</section>
