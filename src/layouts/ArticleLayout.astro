---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Brands from "../components/Brands.astro";
import Footer from "../components/Footer.astro";
import PortableText from "../components/PortableText.astro";
import {
    urlForImage,
    type Article,
    type ArticleListItem,
    type Placement,
} from "../lib/sanity";

interface Props {
    article: Article;
    related: ArticleListItem[];
    currentPlacement: Placement;
}

const { article, related, currentPlacement } = Astro.props;
const {
    title,
    body,
    coverImage,
    quickLinks,
    quickLinksTitle,
    relatedProducts,
    relatedProductsTitle,
} = article;
const categorySlug = currentPlacement.category.slug.current;
const categoryName = currentPlacement.category.name;
const subcategoryName = currentPlacement.subcategory;

const coverUrl = coverImage?.asset
    ? urlForImage(coverImage).width(1600).fit("max").auto("format").url()
    : null;
const coverAlt = coverImage?.alt ?? "";

const sortedQuickLinks = (quickLinks ?? [])
    .filter((q) => q && q.slug && q.categorySlug)
    .sort((a, b) => a.title.localeCompare(b.title, "pl"));

const quickLinksHeader =
    quickLinksTitle?.trim() ||
    "Przejdź do konkretnego artykułu, aby dowiedzieć się więcej:";

const sortedRelatedProducts = (relatedProducts ?? [])
    .filter((p) => p && p.name && p.url)
    .sort((a, b) => a.name.localeCompare(b.name, "pl"));

const relatedProductsHeader =
    relatedProductsTitle?.trim() || "Powiązane produkty:";
---

<Layout title={`${title} — Centrum pomocy`}>
    <Nav variant="light" />
    <main class="article-main">
        <div class="article-container">
            <div class="article-content" data-pagefind-body>
                <div class="article-header">
                    <h1 class="article-title" data-pagefind-meta="title">
                        {title}
                    </h1>
                    <nav
                        class="breadcrumb"
                        aria-label="Ścieżka okruszków"
                        data-pagefind-ignore
                    >
                        <a href="https://wizytowki.co" class="breadcrumb-link"
                            >Strona główna</a
                        >
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <a href="/" class="breadcrumb-link">Centrum pomocy</a>
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <a
                            href={`/${categorySlug}/`}
                            class="breadcrumb-link">{categoryName}</a
                        >
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <span class="breadcrumb-current">{title}</span>
                    </nav>
                    <meta data-pagefind-meta={`kategoria:${categoryName}`} />
                </div>

                {
                    coverUrl && (
                        <img
                            src={coverUrl}
                            alt={coverAlt}
                            class="article-cover"
                            loading="eager"
                            decoding="async"
                        />
                    )
                }

                <article class="article-body">
                    <PortableText value={body} />
                </article>

                {
                    sortedQuickLinks.length > 0 && (
                        <section class="article-quick-links" data-pagefind-ignore>
                            <p class="article-quick-links-intro">
                                {quickLinksHeader}
                            </p>
                            <ul class="article-quick-links-list">
                                {sortedQuickLinks.map((link) => (
                                    <li>
                                        <a
                                            href={`/${link.categorySlug}/${link.slug}/`}
                                            class="article-quick-links-item"
                                        >
                                            {link.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }

                {
                    sortedRelatedProducts.length > 0 && (
                        <section class="article-quick-links" data-pagefind-ignore>
                            <p class="article-quick-links-intro">
                                {relatedProductsHeader}
                            </p>
                            <ul class="article-quick-links-list">
                                {sortedRelatedProducts.map((product) => (
                                    <li>
                                        <a
                                            href={product.url}
                                            class="article-quick-links-item"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {product.name}
                                            {product.description && (
                                                <span class="article-quick-links-desc">
                                                    {" "}
                                                    — {product.description}
                                                </span>
                                            )}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }
            </div>

            {
                related.length > 0 && (
                    <aside
                        class="article-related"
                        aria-label={`Podobne tematy z sekcji ${subcategoryName}`}
                    >
                        <h2 class="related-title">{subcategoryName}</h2>
                        <ul class="related-links">
                            {related.map((rel) => (
                                <li>
                                    <a
                                        href={`/${categorySlug}/${rel.slug.current}/`}
                                        class="related-link"
                                    >
                                        {rel.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </aside>
                )
            }
        </div>
    </main>
    <CtaBanner />
    <Brands />
    <Footer />
</Layout>
