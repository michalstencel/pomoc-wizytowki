---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Brands from "../components/Brands.astro";
import Footer from "../components/Footer.astro";

interface Props {
    article: CollectionEntry<"articles">;
    category: CollectionEntry<"categories"> | undefined;
    related: CollectionEntry<"articles">[];
}

const { article, category, related } = Astro.props;
const { title, subcategory } = article.data;
const [categorySlug] = article.id.split("/");
const categoryName = category?.data.name ?? categorySlug;
---

<Layout title={`${title} — Centrum pomocy`}>
    <Nav variant="light" />
    <main class="article-main">
        <div class="article-container">
            <div class="article-content" data-pagefind-body>
                <div class="article-header">
                    <h1 class="article-title" data-pagefind-meta="title">
                        {title}
                    </h1>
                    <nav class="breadcrumb" aria-label="Ścieżka okruszków" data-pagefind-ignore>
                        <a href="https://wizytowki.co" class="breadcrumb-link"
                            >Strona główna</a
                        >
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <a href="/" class="breadcrumb-link">Centrum pomocy</a>
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <a
                            href={`/${categorySlug}/`}
                            class="breadcrumb-link">{categoryName}</a
                        >
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <span class="breadcrumb-current">{title}</span>
                    </nav>
                    <meta data-pagefind-meta={`kategoria:${categoryName}`} />
                </div>
                <article class="article-body">
                    <slot />
                </article>
            </div>

            {
                related.length > 0 && (
                    <aside class="article-related" aria-label={`Podobne tematy z sekcji ${subcategory}`}>
                        <h2 class="related-title">{subcategory}</h2>
                        <ul class="related-links">
                            {related.map((rel) => {
                                const slug = rel.id
                                    .split("/")
                                    .slice(1)
                                    .join("/");
                                return (
                                    <li>
                                        <a
                                            href={`/${categorySlug}/${slug}/`}
                                            class="related-link"
                                        >
                                            {rel.data.title}
                                        </a>
                                    </li>
                                );
                            })}
                        </ul>
                    </aside>
                )
            }
        </div>
    </main>
    <CtaBanner />
    <Brands />
    <Footer />
</Layout>
