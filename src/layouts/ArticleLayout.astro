---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Brands from "../components/Brands.astro";
import Footer from "../components/Footer.astro";

interface Props {
    article: CollectionEntry<"articles">;
    category: CollectionEntry<"categories"> | undefined;
}

const { article, category } = Astro.props;
const { title, relatedArticles } = article.data;
const [categorySlug] = article.id.split("/");
const categoryName = category?.data.name ?? categorySlug;
---

<Layout title={`${title} — Centrum pomocy`}>
    <Nav variant="light" />
    <main class="article-main">
        <div class="article-container">
            <div class="article-content" data-pagefind-body>
                <div class="article-header">
                    <nav class="breadcrumb" aria-label="Ścieżka okruszków" data-pagefind-ignore>
                        <a href="https://wizytowki.co" class="breadcrumb-link"
                            >Strona główna</a
                        >
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <a href="/" class="breadcrumb-link">Centrum pomocy</a>
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <a
                            href={`/${categorySlug}/`}
                            class="breadcrumb-link">{categoryName}</a
                        >
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <span class="breadcrumb-current">{title}</span>
                    </nav>
                    <h1 class="article-title" data-pagefind-meta="title">
                        {title}
                    </h1>
                    <meta data-pagefind-meta={`category:${categoryName}`} />
                </div>
                <article class="article-body">
                    <slot />
                </article>
            </div>

            {
                relatedArticles && relatedArticles.length > 0 && (
                    <aside class="article-related" aria-label="Podobne tematy">
                        <h2 class="related-title">Podobne tematy</h2>
                        <ul class="related-links">
                            {relatedArticles.map((rel) => (
                                <li>
                                    <a
                                        href={`/${categorySlug}/${rel.slug}/`}
                                        class="related-link"
                                    >
                                        {rel.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </aside>
                )
            }
        </div>
    </main>
    <CtaBanner />
    <Brands />
    <Footer />
</Layout>
