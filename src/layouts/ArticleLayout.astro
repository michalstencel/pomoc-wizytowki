---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Brands from "../components/Brands.astro";
import Footer from "../components/Footer.astro";
import PortableText from "../components/PortableText.astro";
import { urlForImage, type Article, type ArticleListItem } from "../lib/sanity";

interface Props {
    article: Article;
    related: ArticleListItem[];
}

const { article, related } = Astro.props;
const { title, subcategory, body, coverImage, category, quickLinks, quickLinksTitle } = article;
const categorySlug = category.slug.current;
const categoryName = category.name;

const coverUrl = coverImage?.asset
    ? urlForImage(coverImage).width(1600).fit("max").auto("format").url()
    : null;
const coverAlt = coverImage?.alt ?? "";

const sortedQuickLinks = (quickLinks ?? [])
    .filter((q) => q && q.slug && q.categorySlug)
    .sort((a, b) => a.title.localeCompare(b.title, "pl"));

const quickLinksHeader =
    quickLinksTitle?.trim() ||
    "Przejdź do konkretnej kategorii, aby dowiedzieć się więcej:";
---

<Layout title={`${title} — Centrum pomocy`}>
    <Nav variant="light" />
    <main class="article-main">
        <div class="article-container">
            <div class="article-content" data-pagefind-body>
                <div class="article-header">
                    <h1 class="article-title" data-pagefind-meta="title">
                        {title}
                    </h1>
                    <nav
                        class="breadcrumb"
                        aria-label="Ścieżka okruszków"
                        data-pagefind-ignore
                    >
                        <a href="https://wizytowki.co" class="breadcrumb-link"
                            >Strona główna</a
                        >
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <a href="/" class="breadcrumb-link">Centrum pomocy</a>
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <a
                            href={`/${categorySlug}/`}
                            class="breadcrumb-link">{categoryName}</a
                        >
                        <span class="breadcrumb-sep" aria-hidden="true">›</span>
                        <span class="breadcrumb-current">{title}</span>
                    </nav>
                    <meta data-pagefind-meta={`kategoria:${categoryName}`} />
                </div>

                {
                    coverUrl && (
                        <img
                            src={coverUrl}
                            alt={coverAlt}
                            class="article-cover"
                            loading="eager"
                            decoding="async"
                        />
                    )
                }

                <article class="article-body">
                    <PortableText value={body} />
                </article>

                {
                    sortedQuickLinks.length > 0 && (
                        <section class="article-quick-links" data-pagefind-ignore>
                            <p class="article-quick-links-intro">
                                {quickLinksHeader}
                            </p>
                            <ul class="article-quick-links-list">
                                {sortedQuickLinks.map((link) => (
                                    <li>
                                        <a
                                            href={`/${link.categorySlug}/${link.slug}/`}
                                            class="article-quick-links-item"
                                        >
                                            {link.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }
            </div>

            {
                related.length > 0 && (
                    <aside
                        class="article-related"
                        aria-label={`Podobne tematy z sekcji ${subcategory}`}
                    >
                        <h2 class="related-title">{subcategory}</h2>
                        <ul class="related-links">
                            {related.map((rel) => (
                                <li>
                                    <a
                                        href={`/${categorySlug}/${rel.slug.current}/`}
                                        class="related-link"
                                    >
                                        {rel.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </aside>
                )
            }
        </div>
    </main>
    <CtaBanner />
    <Brands />
    <Footer />
</Layout>
