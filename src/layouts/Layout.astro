---
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Centrum pomocy wizytowki.co — wszystko o naszych wizytówkach, zamawianiu, przygotowaniu projektów, czasie realizacji i wsparciu.",
} = Astro.props;
---

<!doctype html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <title>{title}</title>

        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <meta name="theme-color" content="#0c111d" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- Pagefind UI (statyczne pliki generowane podczas `npm run build`) -->
        <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    </head>
    <body>
        <slot />

        <script is:inline>
            // Auto-update strefy czasowej dla Polski (CET ↔ CEST).
            (function () {
                var parts = new Intl.DateTimeFormat("en-US", {
                    timeZone: "Europe/Warsaw",
                    timeZoneName: "short",
                }).formatToParts(new Date());
                var tzPart = parts.find(function (p) {
                    return p.type === "timeZoneName";
                });
                var tzName = tzPart ? tzPart.value : "";
                var tz = tzName.indexOf("+2") !== -1 ? "CEST" : "CET";
                document.querySelectorAll("[data-tz]").forEach(function (el) {
                    el.textContent = tz;
                });
            })();
        </script>
    </body>
</html>
